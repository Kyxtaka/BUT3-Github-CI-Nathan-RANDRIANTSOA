services:
  nathan-randriantsoa-frontend:
    container_name: nathan-randriantsoa-frontend-{{ mode }}
    image: docker.iut.arcanit.io/randriantsoa-nathan-frontend:latest
    env_file: ./backend.env
    restart: always
    networks: [traefik]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-frontend.rule=Host(`{{ domaine_prefix }}randriantsoa-nathan.iut.arcanit.io`)"
      - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-frontend.entrypoints=https"
      - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-frontend.tls=true"
      - "traefik.http.services.{{ mode }}-nathan-randriantsoa-frontend.loadbalancer.server.port=80"

  nathan-randriantsoa-backend:
    container_name: nathan-randriantsoa-backend-{{ mode }}
    image: docker.iut.arcanit.io/randriantsoa-nathan-backend:latest
    env_file: ./backend.env
    restart: always
    networks: [traefik]
    labels:
      - "traefik.enable=true"

      - "traefik.http.routers.{{ mode }}-api-redirect-router.rule=Host(`nathan-api.iut.arcanit.io`)"
      - "traefik.http.routers.{{ mode }}-api-redirect-router.entrypoints=https"
      - "traefik.http.routers.{{ mode }}-api-redirect-router.tls=true"
      - "traefik.http.routers.{{ mode }}-api-redirect-router.service=@internal" 

      # - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-backend.rule=Host(`{{ domaine_prefix }}nathan-api.iut.arcanit.io`)"
      # - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-backend.entrypoints=https"
      # - "traefik.http.routers.{{ mode }}-nathan-randriantsoa-backend.tls=true"
      # - "traefik.http.services.{{ mode }}-nathan-randriantsoa-backend.loadbalancer.server.port=80"

      # - "traefik.http.middlewares.{{ mode }}-api-redirect.redirectregex.regex=^https?://nathan-api.iut.arcanit.io/(.*)"
      # - "traefik.http.middlewares.{{ mode }}-api-redirect.redirectregex.replacement=https://{{ domaine_prefix }}nathan-api.iut.arcanit.io/$${1}" 
      # - "traefik.http.middlewares.{{ mode }}-api-redirect.redirectregex.permanent=true"

      # - "traefik.http.routers.{{ mode }}-api-redirect-router.middlewares={{ mode }}-api-redirect"
      
       

networks:
  traefik:
    external: true
